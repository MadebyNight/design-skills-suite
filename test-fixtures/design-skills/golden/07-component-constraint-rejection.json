      "deliverableType": "alipay.home",
      "audience": "用户",
      "brandConstraints": ["只允许使用现有首页组件", "禁止修改 tokens"],
      "contentRequirements": ["保留基础首页结构"],
      "visualConstraints": ["保持现有风格"],
      "outputSpec": { "width": 375, "height": 812, "format": "png" },
      "inputArtifacts": [],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schemas.design-agent.local/design-skill/v1/landing-config.schema.json",
  "title": "LandingSchema",
  "schemaVersion": "1.0.0",
  "description": "LandingSchema：落地页交付唯一配置合同（landing-config.json）。仅在既有 Catalog 七类白名单模块内实例化，可增删排序；严格 Schema，禁止未定义字段。不含生产 pageCode、发布状态、缓存状态、生成日志或校验过程。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "page",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "landing-schema/v1"
    },
    "page": {
      "description": "页面级可修改配置；生产 pageCode 由服务端生成，Skill 不伪造。",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "navTitle", "background", "activityTime"],
      "properties": {
        "name": {
          "description": "后台页面名称，1–40 字符。",
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "navTitle": {
          "description": "小程序导航标题，1–15 字符。",
          "type": "string",
          "minLength": 1,
          "maxLength": 15
        },
        "background": {
          "description": "页面背景：纯色或图片二选一。",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "color"],
              "properties": {
                "type": { "const": "color" },
                "color": { "$ref": "#/$defs/hexColor" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "image"],
              "properties": {
                "type": { "const": "image" },
                "image": { "$ref": "#/$defs/relativeAssetPath" }
              }
            }
          ]
        },
        "activityTime": {
          "description": "活动时间：留空由用户手动填写；配置指南标注发布前必填。",
          "type": "object",
          "additionalProperties": false,
          "required": ["startTime", "endTime"],
          "properties": {
            "startTime": {
              "description": "留空为空字符串，由用户在业务系统填写。",
              "type": "string",
              "maxLength": 0
            },
            "endTime": {
              "type": "string",
              "maxLength": 0
            }
          }
        }
      }
    },
    "landingKey": {
      "description": "联合任务中非生产、任务内稳定的落地页标识，如 landing-01；独立交付可省略。",
      "type": "string",
      "pattern": "^landing-[0-9]{2,}$"
    },
    "modules": {
      "description": "白名单模块集合与顺序；模块位置由本数组顺序表达，用户显式偏好可覆盖。禁止空页面。",
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/moduleHeroImage" },
          { "$ref": "#/$defs/moduleImageAd" },
          { "$ref": "#/$defs/moduleSectionTitle" },
          { "$ref": "#/$defs/moduleCouponGroup" },
          { "$ref": "#/$defs/moduleProductCollection" },
          { "$ref": "#/$defs/moduleActionButton" },
          { "$ref": "#/$defs/moduleSpacer" }
        ]
      }
    },
    "pendingResourceRequests": {
      "description": "尚未确定资源的结构化待补请求；已解析引用与待补请求可并存。",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resourceType", "criteria", "purpose", "moduleRef"],
        "properties": {
          "resourceType": {
            "type": "string",
            "enum": ["product", "coupon"]
          },
          "criteria": {
            "description": "资源检索条件，由运营或业务系统补齐真实资源。",
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "moduleRef": {
            "description": "待补资源对应模块的稳定模块 ID。",
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "relativeAssetPath": {
      "description": "素材包内相对路径，引用一律使用相对路径，不引入系统资源 ID 或 Base64。",
      "type": "string",
      "minLength": 1,
      "$comment": "禁止反斜杠与 .. 路径段（正向前瞻实现，验证器子集无 not 关键字）。",
      "pattern": "^(?!(?:.*[/\\\\])?\\.\\.(?:/|$))[^\\\\]+$"
    },
    "jumpIntent": {
      "description": "用户明确要求跳转时记录的待确认跳转请求；主图/广告图/按钮可没有跳转。",
      "type": "object",
      "additionalProperties": false,
      "required": ["targetType", "params"],
      "properties": {
        "targetType": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object"
        }
      }
    },
    "spacingRpx": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40
    },
    "colorOrImageBackground": {
      "description": "背景：透明/无、纯色或图片。",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "transparent" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "color"],
          "properties": {
            "mode": { "const": "color" },
            "color": { "$ref": "#/$defs/hexColor" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "image"],
          "properties": {
            "mode": { "const": "image" },
            "image": { "$ref": "#/$defs/relativeAssetPath" }
          }
        }
      ]
    },
    "moduleHeroImage": {
      "description": "HERO_IMAGE：单页最多 1 个；图片建议 1500×720px。",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "image", "cornerRadiusRpx", "marginTopRpx", "marginBottomRpx"],
      "properties": {
        "type": { "const": "HERO_IMAGE" },
        "id": { "$ref": "#/$defs/moduleId" },
        "image": { "$ref": "#/$defs/relativeAssetPath" },
        "cornerRadiusRpx": { "type": "integer", "minimum": 0, "maximum": 24 },
        "marginTopRpx": { "$ref": "#/$defs/spacingRpx" },
        "marginBottomRpx": { "$ref": "#/$defs/spacingRpx" },
        "jumpIntent": { "$ref": "#/$defs/jumpIntent" }
      }
    },
    "moduleImageAd": {
      "description": "IMAGE_AD：单图模式恰好 1 张（建议 1404×480px）或双图模式恰好 2 张（建议单张 686×480px）；mode 与图片数量在此耦合。",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "mode", "images", "cornerRadiusRpx"],
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "mode", "images", "cornerRadiusRpx"],
          "properties": {
            "type": { "const": "IMAGE_AD" },
            "id": { "$ref": "#/$defs/moduleId" },
            "mode": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "count"],
              "properties": {
                "mode": { "const": "single" },
                "count": { "const": 1 }
              }
            },
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "$ref": "#/$defs/relativeAssetPath" }
            },
            "cornerRadiusRpx": { "type": "integer", "minimum": 0, "maximum": 24 },
            "jumpIntent": { "$ref": "#/$defs/jumpIntent" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "mode", "images", "cornerRadiusRpx"],
          "properties": {
            "type": { "const": "IMAGE_AD" },
            "id": { "$ref": "#/$defs/moduleId" },
            "mode": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "count"],
              "properties": {
                "mode": { "const": "double" },
                "count": { "const": 2 }
              }
            },
            "images": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/relativeAssetPath" }
            },
            "cornerRadiusRpx": { "type": "integer", "minimum": 0, "maximum": 24 },
            "jumpIntent": { "$ref": "#/$defs/jumpIntent" }
          }
        }
      ],
      "properties": {
        "type": { "const": "IMAGE_AD" },
        "id": { "$ref": "#/$defs/moduleId" },
        "mode": { "type": "object" },
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/relativeAssetPath" }
        },
        "cornerRadiusRpx": { "type": "integer", "minimum": 0, "maximum": 24 },
        "jumpIntent": { "$ref": "#/$defs/jumpIntent" }
      }
    },
    "moduleSectionTitle": {
      "description": "SECTION_TITLE：文字 1–20 字；字号仅 28rpx/32rpx；图片宽 120–702rpx。",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "mode"],
      "properties": {
        "type": { "const": "SECTION_TITLE" },
        "id": { "$ref": "#/$defs/moduleId" },
        "mode": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "text", "fontSizeRpx", "bold", "textColor", "backgroundColor", "align"],
              "properties": {
                "mode": { "const": "text" },
                "text": { "type": "string", "minLength": 1, "maxLength": 20 },
                "fontSizeRpx": { "type": "integer", "enum": [28, 32] },
                "bold": { "type": "boolean" },
                "textColor": { "$ref": "#/$defs/hexColor" },
                "backgroundColor": { "$ref": "#/$defs/hexColor" },
                "align": { "type": "string", "enum": ["left", "center"] },
                "marginTopRpx": { "$ref": "#/$defs/spacingRpx" },
                "marginBottomRpx": { "$ref": "#/$defs/spacingRpx" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "image", "displayWidthRpx", "align"],
              "properties": {
                "mode": { "const": "image" },
                "image": { "$ref": "#/$defs/relativeAssetPath" },
                "displayWidthRpx": { "type": "integer", "minimum": 120, "maximum": 702 },
                "align": { "type": "string", "enum": ["left", "center"] },
                "marginTopRpx": { "$ref": "#/$defs/spacingRpx" },
                "marginBottomRpx": { "$ref": "#/$defs/spacingRpx" }
              }
            }
          ]
        }
      }
    },
    "moduleCouponGroup": {
      "description": "COUPON_GROUP：每模块 1–6 张；模块位置由 modules 数组顺序表达；仅保存营销中心模板引用 ID；领取资格、库存及展示状态由运行时装配。",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "coupons", "overallBackground", "amountAreaBackground", "contentAreaBackground"],
      "properties": {
        "type": { "const": "COUPON_GROUP" },
        "id": { "$ref": "#/$defs/moduleId" },
        "coupons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["couponTemplateId"],
            "properties": {
              "couponTemplateId": {
                "description": "营销中心模板引用 ID；伪造资源被明确拒绝。",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "overallBackground": { "$ref": "#/$defs/colorOrImageBackground" },
        "amountAreaBackground": { "$ref": "#/$defs/colorOrImageBackground" },
        "contentAreaBackground": { "$ref": "#/$defs/colorOrImageBackground" }
      }
    },
    "moduleProductCollection": {
      "description": "PRODUCT_COLLECTION：每模块 1–40 个商品；模块位置由 modules 数组顺序表达；仅引用商品中心可展示商品；集合内商品 ID 不重复。",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "products", "spacingRpx", "background"],
      "properties": {
        "type": { "const": "PRODUCT_COLLECTION" },
        "id": { "$ref": "#/$defs/moduleId" },
        "products": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["productId"],
            "properties": {
              "productId": {
                "description": "商品中心资源引用 ID。",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "spacingRpx": { "type": "integer", "minimum": 0, "maximum": 32 },
        "background": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "const": "none" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "color"],
              "properties": {
                "mode": { "const": "color" },
                "color": { "$ref": "#/$defs/hexColor" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "image"],
              "properties": {
                "mode": { "const": "image" },
                "image": { "$ref": "#/$defs/relativeAssetPath" }
              }
            }
          ]
        }
      }
    },
    "moduleActionButton": {
      "description": "ACTION_BUTTON：用户明确提出跳转需求时才规划；文案 2–8 字；发布前必须有受控跳转。",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "text", "cornerRadiusRpx", "jumpIntent"],
      "properties": {
        "type": { "const": "ACTION_BUTTON" },
        "id": { "$ref": "#/$defs/moduleId" },
        "text": { "type": "string", "minLength": 2, "maxLength": 8 },
        "cornerRadiusRpx": { "type": "integer", "minimum": 0, "maximum": 44 },
        "jumpIntent": { "$ref": "#/$defs/jumpIntent" }
      }
    },
    "moduleSpacer": {
      "description": "SPACER：高度 8–80rpx、步长 8rpx；无边框。",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "heightRpx", "background"],
      "properties": {
        "type": { "const": "SPACER" },
        "id": { "$ref": "#/$defs/moduleId" },
        "heightRpx": { "type": "integer", "minimum": 8, "maximum": 80, "multipleOf": 8 },
        "background": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "const": "transparent" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "color"],
              "properties": {
                "mode": { "const": "color" },
                "color": { "$ref": "#/$defs/hexColor" }
              }
            }
          ]
        }
      }
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schemas.design-agent.local/design-skill/v1/batch-design-request.schema.json",
  "title": "BatchDesignRequest",
  "schemaVersion": "1.0.0",
  "description": "批量页面设计请求：一组 DesignBrief + AssetPolicy 的输入。pageLinkage 为可选的页面关联元数据，仅联合任务启用；不影响无联动的存量批次。landingKey 为任务内稳定标识，不替代生产 pageCode。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "batchId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "brief",
          "assetPolicy"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "brief": {
            "$ref": "design-brief.schema.json"
          },
          "assetPolicy": {
            "$ref": "asset-policy.schema.json"
          }
        }
      }
    },
    "pageLinkage": {
      "description": "可选页面关联元数据：声明首页主题、落地页主题、landingKey 与主题覆盖规则。唯一性等语义检查由编排器在加载时执行，Schema 层面不校验。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "homeTheme",
        "landingThemes"
      ],
      "properties": {
        "homeTheme": {
          "description": "首页宽泛主题；用户显式提供主题时完全替换默认主题。",
          "type": "string",
          "minLength": 1
        },
        "landingThemes": {
          "description": "落地页主题列表；编排器按规范化后的顺序生成 landing-01、landing-02 等稳定 landingKey。",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "theme"
            ],
            "properties": {
              "theme": {
                "type": "string",
                "minLength": 1
              },
              "landingKey": {
                "description": "任务内稳定标识；建议由编排器生成，请求中可省略。",
                "type": "string",
                "pattern": "^landing-[0-9]{2,}$"
              }
            }
          }
        }
      }
    }
  }
}

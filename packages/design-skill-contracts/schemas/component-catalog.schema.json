{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schemas.design-agent.local/design-skill/v1/component-catalog.schema.json",
  "title": "ComponentCatalog",
  "schemaVersion": "1.0.0",
  "description": "组件目录：由组件库自动生成，作为页面结构和样式的硬约束，不手工复制维护。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceCommit",
    "pageType",
    "components"
  ],
  "properties": {
    "sourceCommit": {
      "type": "string",
      "minLength": 1
    },
    "pageType": {
      "type": "string",
      "enum": ["alipay.home", "alipay.landing"]
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domTemplate", "allowedClasses", "allowedVariants", "slots"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "domTemplate": { "type": "string", "minLength": 1 },
        "allowedClasses": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allowedVariants": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["text", "image"]
        },
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "aspectRatio": { "type": "string", "minLength": 1 },
        "objectFit": { "type": "string", "minLength": 1 },
        "maxCount": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

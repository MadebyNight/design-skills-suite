{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schemas.design-agent.local/design-skill/v1/skill-manifest.schema.json",
  "title": "SkillManifest",
  "schemaVersion": "1.0.0",
  "description": "Skill 清单：声明 Skill 身份、输入输出 Schema、提供/需要的能力、执行与验证入口。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "entrypoint",
    "inputSchema",
    "outputSchema",
    "provides",
    "requires",
    "automatic",
    "confirmationPoints",
    "verifyCommand"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "inputSchema": {
      "description": "Skill 接受的输入对象 Schema 引用。",
      "type": "string",
      "minLength": 1
    },
    "outputSchema": {
      "description": "Skill 产生的输出对象 Schema 引用。",
      "type": "string",
      "minLength": 1
    },
    "provides": {
      "description": "本 Skill 提供的能力 ID 清单，只允许已登记能力。",
      "type": "array",
      "items": {
        "$ref": "capability-manifest.schema.json#/properties/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requires": {
      "description": "本 Skill 需要的其他能力 ID 清单，只允许已登记能力。",
      "type": "array",
      "items": {
        "$ref": "capability-manifest.schema.json#/properties/id"
      },
      "uniqueItems": true
    },
    "automatic": {
      "type": "boolean"
    },
    "confirmationPoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verifyCommand": {
      "type": "string",
      "minLength": 1
    }
  }
}

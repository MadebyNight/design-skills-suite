{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schemas.design-agent.local/design-skill/v1/design-brief.schema.json",
  "title": "DesignBrief",
  "schemaVersion": "1.0.0",
  "description": "统一表达用户页面设计需求，作为页面 Skill 的输入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "goal",
    "deliverableType",
    "audience",
    "brandConstraints",
    "contentRequirements",
    "visualConstraints",
    "outputSpec",
    "inputArtifacts",
    "researchPolicy",
    "forbiddenChanges"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "deliverableType": {
      "type": "string",
      "enum": ["alipay.home", "alipay.landing"]
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "brandConstraints": {
      "description": "品牌与视觉硬约束。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contentRequirements": {
      "description": "文案与内容要求。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visualConstraints": {
      "description": "视觉方向与风格约束。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputSpec": {
      "description": "输出尺寸与格式规格。",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "inputArtifacts": {
      "description": "已有素材（AssetResult 列表）。",
      "type": "array",
      "items": {
        "$ref": "asset-result.schema.json"
      }
    },
    "researchPolicy": {
      "type": "string",
      "enum": ["none", "optional", "required"]
    },
    "forbiddenChanges": {
      "description": "禁止项：修改组件、改圆角、新增 class 等。",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

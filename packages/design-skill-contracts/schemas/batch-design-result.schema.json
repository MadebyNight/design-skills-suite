{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schemas.design-agent.local/design-skill/v1/batch-design-result.schema.json",
  "title": "BatchDesignResult",
  "schemaVersion": "1.0.0",
  "description": "批量页面设计结果：按 item 汇总状态，产物通过路径引用，不内嵌 OrchestrationResult。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "status",
    "summary",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "batchId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "status": {
      "type": "string",
      "enum": ["succeeded", "partially_failed", "failed"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "succeeded",
        "failed",
        "skipped"
      ],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "status",
          "attempt",
          "outputRoot",
          "resultPath",
          "error"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "status": {
            "type": "string",
            "enum": ["succeeded", "failed", "skipped"]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "outputRoot": {
            "type": "string",
            "minLength": 1
          },
          "resultPath": {
            "type": "string",
            "minLength": 1
          },
          "error": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "retryable",
              "outcomeUnknown"
            ],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "retryable": { "type": "boolean" },
              "outcomeUnknown": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}

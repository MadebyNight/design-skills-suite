{
  "id": "./",
  "name": "OpenShop 图像编辑器",
  "version": "0.24.0-host.6",
  "short_name": "OpenShop",
  "description": "私密的浏览器端图像编辑器，支持图层、选区、PSD 交换与可选的本地浏览器 AI。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0a0c10",
  "theme_color": "#0a0c10",
  "categories": [
    "graphics",
    "photo"
  ],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "image/png": [
          ".png"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/webp": [
          ".webp"
        ],
        "image/gif": [
          ".gif"
        ],
        "image/vnd.adobe.photoshop": [
          ".psd"
        ],
        "application/vnd.openshop+json": [
          ".openshop"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ]
}

{
  "name": "openphoto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "files": [
    "SKILL.md",
    "manifest.json",
    "agents",
    "bin",
    "runtime",
    "assets",
    "manifests",
    "references"
  ],
  "bin": { "openphoto": "./bin/openphoto.mjs" },
  "scripts": {
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test --config tests/playwright.config.mjs",

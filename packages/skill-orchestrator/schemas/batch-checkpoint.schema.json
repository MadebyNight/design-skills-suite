{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://schemas.design-agent.local/design-skill/v1/batch-checkpoint.schema.json",
  "title": "BatchCheckpoint",
  "schemaVersion": "1.0.0",
  "description": "批量编排的持久化检查点：记录批次级状态、provider 身份、逐 item 进度与可选页面联动摘要。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "batchId",
    "batchRequest",
    "requestFingerprint",
    "sourceCommit",
    "provider",
    "status",
    "createdAt",
    "updatedAt",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "batchRequest": {
      "description": "批次请求（设计 brief 等）。",
      "type": "object"
    },
    "requestFingerprint": {
      "description": "batchRequest 的稳定 SHA256 指纹，用于兼容性校验。",
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model", "baseUrlFingerprint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "baseUrlFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["running", "succeeded", "partially_failed", "failed"]
    },
    "linkage": {
      "description": "可选页面联动（pageLinkage）终态摘要：仅在联动批次写入；warning 记录失败落地页等非阻断信息。",
      "type": "object",
      "additionalProperties": false,
      "required": ["homeTheme", "landingThemes", "warnings"],
      "properties": {
        "homeTheme": { "type": "string", "minLength": 1 },
        "landingThemes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["landingKey", "theme", "source"],
            "properties": {
              "landingKey": {
                "type": "string",
                "pattern": "^landing-[0-9]{2,}$"
              },
              "theme": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "enum": ["orchestrator", "default"] },
              "landingPreviewRef": {
                "description": "可关联落地页 attempt 内 prototype.html 相对批次根的 POSIX 路径，仅用于离线预览。可关联=成功落地页，或素材失败但已生成带诊断占位、可审阅原型的落地页。",
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemId",
        "status",
        "attempt",
        "attemptRoot",
        "assets",
        "resultPath",
        "error"
      ],
      "properties": {
        "itemId": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "interrupted", "succeeded", "failed", "unsupported"]
        },
        "attempt": { "type": "integer", "minimum": 0 },
        "attemptRoot": { "type": ["string", "null"] },
        "assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/asset" }
        },
        "resultPath": { "type": ["string", "null"] },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetKey", "status", "result", "error"],
      "properties": {
        "assetKey": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "succeeded", "failed", "invalidated", "interrupted"]
        },
        "result": { "type": ["object", "null"] },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "outcomeUnknown"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "outcomeUnknown": { "type": "boolean" }
      }
    }
  }
}
